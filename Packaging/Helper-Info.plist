<?xml version="1.0" encoding="UTF-8"?>
<!--
  Info.plist for the embedded AppLockHelper.app.

  The helper is a headless accessory (LSUIElement) with no UI of its own beyond
  the lock overlays and system authentication sheet. Its bundle identifier is a
  child of the main app's, which SMAppService requires for a bundled agent.
-->
<plist version="1.0">
<dict>
    <key>CFBundleName</key>
    <string>AppLockHelper</string>
    <key>CFBundleDisplayName</key>
    <string>AppLock Helper</string>
    <key>CFBundleIdentifier</key>
    <string>gg.tame.applock.helper</string>
    <key>CFBundleExecutable</key>
    <string>AppLockHelper</string>
    <key>CFBundlePackageType</key>
    <string>APPL</string>
    <key>CFBundleShortVersionString</key>
    <string>0.1.0</string>
    <key>CFBundleVersion</key>
    <string>1</string>
    <key>LSMinimumSystemVersion</key>
    <string>15.0</string>
    <key>LSUIElement</key>
    <true/>
    <key>NSHighResolutionCapable</key>
    <true/>
    <key>NSPrincipalClass</key>
    <string>NSApplication</string>
</dict>
</plist>
