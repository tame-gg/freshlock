<?xml version="1.0" encoding="UTF-8"?>
<!--
  Additional host-app entitlements needed to *install* an Endpoint Security
  system extension. Merge into FreshLock.entitlements only after Apple approves
  the ES entitlement and packaging embeds the .systemextension.

  Until then, FreshLock.entitlements stays minimal (Phase 0).
-->
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>com.apple.security.app-sandbox</key>
    <false/>
    <key>com.apple.developer.system-extension.install</key>
    <true/>
</dict>
</plist>
