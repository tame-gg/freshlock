<?xml version="1.0" encoding="UTF-8"?>
<!--
  launchd property list for the FreshLock background helper.

  This file is placed in the main app bundle at
  Contents/Library/LaunchAgents/gg.tame.freshlock.helper.plist and registered via
  `SMAppService.agent(plistName: "gg.tame.freshlock.helper.plist")`.

  `BundleProgram` is resolved relative to the main app bundle, pointing at the
  embedded helper executable. `RunAtLoad` + `KeepAlive` keep protection running
  across logout/login and restart the helper if it ever exits.
-->
<plist version="1.0">
<dict>
    <key>Label</key>
    <string>gg.tame.freshlock.helper</string>

    <key>BundleProgram</key>
    <string>Contents/Library/LoginItems/FreshLockHelper.app/Contents/MacOS/FreshLockHelper</string>

    <key>RunAtLoad</key>
    <true/>

    <key>KeepAlive</key>
    <true/>

    <key>ProcessType</key>
    <string>Interactive</string>

    <key>AssociatedBundleIdentifiers</key>
    <array>
        <string>gg.tame.freshlock</string>
    </array>
</dict>
</plist>
